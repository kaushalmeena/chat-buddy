{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "import",
    "promise",
    "jsx-a11y",
    "vitest"
  ],
  "jsPlugins": ["oxlint-tailwindcss"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "LanguageModel": "readonly"
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/styles/global.css"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/no-array-index-key": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/prefer-add-event-listener": "off",
    "prefer-const": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "typescript/no-unused-vars": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-contradicting-variants": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-dynamic-classes": "error",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/enforce-canonical": "warn",
    "tailwindcss/enforce-shorthand": "warn",
    "tailwindcss/no-unnecessary-arbitrary-value": "warn",
    "tailwindcss/no-unnecessary-whitespace": "warn",
    "tailwindcss/consistent-variant-order": "warn",
    "tailwindcss/no-hardcoded-colors": "warn",
    "tailwindcss/prefer-scale-token": "warn",
    "typescript/unbound-method": "off",
    "typescript/consistent-return": "off",
    "import/no-named-as-default": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/require-post-message-target-origin": "off",
    "promise/always-return": "off",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  },
  "overrides": [
    {
      "files": ["scripts/**", "plugins/**"],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["vite.config.ts", "vitest.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["worker/**"],
      "rules": {
        "no-underscore-dangle": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/**/__tests__/**", "src/test/**"],
      "rules": {
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "no-await-in-loop": "off",
        "typescript/no-unnecessary-type-conversion": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "dev-dist/**", "public/icons/**", "coverage/**"]
}
