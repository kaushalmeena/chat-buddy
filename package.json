{
  "name": "chat-buddy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A private-by-default chat companion that runs its language model entirely in your browser.",
  "repository": "git@github.com:kaushalmeena/chat-buddy.git",
  "author": "Kaushal Meena <kaushal.meena1996@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.10.0",
    "lucide": "^1.27.0",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "jsdom": "^27.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@mlc-ai/web-llm": "^0.2.84"
  }
}
